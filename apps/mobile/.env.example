# Public coordination backend used by native Expo builds.
# Copy this file to apps/mobile/.env only when overriding the compiled default.
EXPO_PUBLIC_DSM_BACKEND_URL=https://disaster-management-web-authority.vercel.app

# Optional public map/routing providers. The app has working defaults when these
# are omitted.
# EXPO_PUBLIC_DSM_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# EXPO_PUBLIC_DSM_ROUTING_URL=https://valhalla1.openstreetmap.de/route
