{
  "expo": {
    "name": "Disaster SOS Mesh",
    "slug": "disaster-sos-mesh",
    "version": "0.1.0",
    "scheme": "dsm",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["android"],
    "android": {
      "package": "com.dsm.disastersosmesh",
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "./withMonorepoFix",
      "expo-router",
      "expo-location",
      "expo-notifications",
      "@maplibre/maplibre-react-native"
    ]
  }
}
