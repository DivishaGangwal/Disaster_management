# ==========================================
# DISASTER SOS MESH - ENVIRONMENT CONFIG
# ==========================================

# 1. NODE VERSION (Required for Render)
NODE_VERSION=22.5.0

# 2. OPERATIONS SECURITY KEY (Required)
# Security key used to log into the Web Operations Console
DSM_OPERATIONS_KEY=mumbai-operations-local

# 3. DEMO MODE
# Enable pre-seeded demo data for Mumbai operational region (Recommended: true)
DSM_DEMO_MODE=true

# 4. DATABASE PATH
# For Render: ./data/mumbai-operations.sqlite
# For Vercel: /tmp/mumbai-operations.sqlite
DSM_DATABASE_PATH=./data/mumbai-operations.sqlite

# 5. SERVER PORT
# Render automatically sets PORT=10000; local default is 8787
PORT=10000

# 6. MOBILE APP BACKEND URL (For Expo Mobile App)
# Set this to your live Render domain so phones can sync with your online backend
EXPO_PUBLIC_DSM_BACKEND_URL=https://disaster-management-web-authority.vercel.app
