{
  "name": "disaster-sos-mesh",
  "private": true,
  "version": "0.1.0",
  "description": "Disaster SOS Mesh - offline-first Bluetooth mesh emergency communication (SIH hackathon prototype)",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/web-authority",
    "packages/*",
    "apps/*",
    "tools/*",
    "native/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean",
    "typecheck": "tsc --build tsconfig.build.json",
    "test": "npm run build && node --test --test-reporter=spec \"packages/*/dist/**/*.test.js\" \"apps/backend/dist/**/*.test.js\"",
    "sim": "npm run build && node packages/simulator/dist/cli.js",
    "seed": "npm run build && node tools/seed/dist/cli.js",
    "boundaries": "node tools/boundaries/check-boundaries.mjs",
    "backend": "npm run build && node apps/backend/dist/main.js",
    "web:build": "npm run build --workspace @dsm/web-authority",
    "web:dev": "npm run dev --workspace @dsm/web-authority",
    "demo": "npm run build && npm run web:build && node apps/backend/dist/main.js",
    "fuzz": "npm run build && node tools/fuzz/fuzz.mjs",
    "start": "npm --workspace @dsm/mobile run start",
    "android": "npm --workspace @dsm/mobile run android",
    "ios": "npm --workspace @dsm/mobile run ios"
  },
  "devDependencies": {},
  "dependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-native": "0.76.9"
  }
}
